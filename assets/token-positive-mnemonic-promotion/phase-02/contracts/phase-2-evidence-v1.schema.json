{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://a-lang.invalid/schemas/token-positive-mnemonic/phase-2-evidence-v1.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["format", "qualification_digest", "registration_digest", "token_report_digest", "protocol_oracle_digest", "schedule_digest", "replay", "mutation", "residency", "hosted_calls_observed", "efficacy_observations", "network_authorized", "model_fidelity_claim", "evidence_digest"],
  "properties": {
    "format": {"const": "alang-token-positive-phase-2-evidence-v1"},
    "qualification_digest": {"$ref": "#/$defs/digest"}, "registration_digest": {"$ref": "#/$defs/digest"}, "token_report_digest": {"$ref": "#/$defs/digest"}, "protocol_oracle_digest": {"$ref": "#/$defs/digest"}, "schedule_digest": {"$ref": "#/$defs/digest"}, "evidence_digest": {"$ref": "#/$defs/digest"},
    "replay": {"type": "object", "additionalProperties": false, "required": ["development_cases", "prior_confirmatory_cases", "fresh_cases", "generated_cases", "valid_pair_count", "source_map_count", "invalid_conformance_inputs", "invalid_acceptance_classes_equal", "replay_digest"], "properties": {"development_cases": {"const": 24}, "prior_confirmatory_cases": {"const": 48}, "fresh_cases": {"const": 48}, "generated_cases": {"const": 16}, "valid_pair_count": {"const": 136}, "source_map_count": {"const": 272}, "invalid_conformance_inputs": {"const": 6}, "invalid_acceptance_classes_equal": {"const": true}, "replay_digest": {"$ref": "#/$defs/digest"}}},
    "mutation": {"type": "object", "additionalProperties": false, "required": ["detected", "total", "all_detected", "names"], "properties": {"detected": {"const": 18}, "total": {"const": 18}, "all_detected": {"const": true}, "names": {"type": "array", "minItems": 18, "maxItems": 18, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}},
    "residency": {"type": "object", "additionalProperties": false, "required": ["format", "engine", "module_count", "modules", "foreign_source_count", "forbidden_import_count", "ports", "nifs", "shell_commands", "interpreted_forms"], "properties": {"format": {"const": "alang-token-positive-phase-2-residency-v1"}, "engine": {"const": "ERTS"}, "module_count": {"const": 16}, "modules": {"type": "array", "minItems": 16, "maxItems": 16, "items": {"type": "object", "additionalProperties": false, "required": ["module", "source_path", "source_sha256", "beam_sha256", "imports"], "properties": {"module": {"type": "string", "minLength": 1}, "source_path": {"type": "string", "pattern": "\\.erl$"}, "source_sha256": {"$ref": "#/$defs/digest"}, "beam_sha256": {"$ref": "#/$defs/digest"}, "imports": {"type": "array", "items": {"type": "string"}}}}}, "foreign_source_count": {"const": 0}, "forbidden_import_count": {"const": 0}, "ports": {"const": false}, "nifs": {"const": false}, "shell_commands": {"const": false}, "interpreted_forms": {"const": false}}},
    "hosted_calls_observed": {"const": 0}, "efficacy_observations": {"const": 0}, "network_authorized": {"const": false}, "model_fidelity_claim": {"const": false}
  },
  "$defs": {"digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
