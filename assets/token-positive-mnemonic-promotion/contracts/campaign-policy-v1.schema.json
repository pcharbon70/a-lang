{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://a-lang.invalid/schemas/token-positive-mnemonic/campaign-policy-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "network_default",
    "live_opt_in",
    "availability",
    "design",
    "per_request_ceilings",
    "campaign_ceilings",
    "replacement",
    "retention",
    "invalid_campaign_triggers"
  ],
  "properties": {
    "format": {
      "const": "alang-token-positive-campaign-policy-v1"
    },
    "network_default": {
      "const": "disabled"
    },
    "live_opt_in": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "environment_variable",
        "required_value",
        "endpoint",
        "credentials_required"
      ],
      "properties": {
        "environment_variable": {
          "const": "ALANG_ALLOW_MNEMONIC_MODEL_CALLS"
        },
        "required_value": {
          "const": "1"
        },
        "endpoint": {
          "const": "http://127.0.0.1:11434"
        },
        "credentials_required": {
          "const": []
        }
      }
    },
    "availability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "probe",
        "all_profiles_required_before_authorization",
        "missing_profile",
        "manifest_mismatch"
      ],
      "properties": {
        "probe": {
          "const": "ollama-manifest-sha256"
        },
        "all_profiles_required_before_authorization": {
          "const": true
        },
        "missing_profile": {
          "const": "block-campaign"
        },
        "manifest_mismatch": {
          "const": "invalidate-campaign"
        }
      }
    },
    "design": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "semantic_cases",
        "primary_cells",
        "hard_request_ceiling",
        "model_families",
        "paired_repetitions",
        "protocols",
        "conditions"
      ],
      "properties": {
        "semantic_cases": {
          "const": 48
        },
        "primary_cells": {
          "const": 1536
        },
        "hard_request_ceiling": {
          "const": 3072
        },
        "model_families": {
          "const": 2
        },
        "paired_repetitions": {
          "const": 2
        },
        "protocols": {
          "const": 4
        },
        "conditions": {
          "const": 2
        }
      }
    },
    "per_request_ceilings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "accepted_source_bytes",
        "accepted_input_bytes",
        "accepted_response_bytes",
        "max_output_tokens",
        "timeout_ms"
      ],
      "properties": {
        "accepted_source_bytes": {
          "const": 8192
        },
        "accepted_input_bytes": {
          "const": 32768
        },
        "accepted_response_bytes": {
          "const": 8192
        },
        "max_output_tokens": {
          "const": 8192
        },
        "timeout_ms": {
          "const": 120000
        }
      }
    },
    "campaign_ceilings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary_requests",
        "all_requests",
        "local_compute_minutes",
        "monetary_cost_usd"
      ],
      "properties": {
        "primary_requests": {
          "const": 1536
        },
        "all_requests": {
          "const": 3072
        },
        "local_compute_minutes": {
          "const": 6400
        },
        "monetary_cost_usd": {
          "const": 0
        }
      }
    },
    "replacement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "blind_retry",
        "max_replacements_per_primary_cell",
        "allowed_only_when",
        "forbidden_when"
      ],
      "properties": {
        "blind_retry": {
          "const": false
        },
        "max_replacements_per_primary_cell": {
          "const": 1
        },
        "allowed_only_when": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 2,
          "uniqueItems": true
        },
        "forbidden_when": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "retention": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "retain",
        "exclude",
        "path",
        "minimum_days"
      ],
      "properties": {
        "retain": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "exclude": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "path": {
          "const": "build/token-positive-mnemonic-promotion/phase-03/evidence"
        },
        "minimum_days": {
          "const": 365
        }
      }
    },
    "invalid_campaign_triggers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    }
  }
}
