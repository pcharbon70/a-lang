{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://a-lang.invalid/schemas/token-positive-mnemonic/traceability-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "sources",
    "design_evidence",
    "included_scope",
    "excluded_scope",
    "observation_boundary"
  ],
  "properties": {
    "format": {
      "const": "alang-token-positive-traceability-v1"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role",
          "path"
        ],
        "properties": {
          "role": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "minItems": 5,
      "maxItems": 5
    },
    "design_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "previous_semantic_cases",
        "model_calls_observed",
        "r0_document_tokens",
        "r2_document_tokens",
        "r2_document_savings",
        "every_measured_document_and_request_cheaper",
        "model_fidelity_claim"
      ],
      "properties": {
        "role": {
          "const": "candidate-selection-and-threshold-design-only"
        },
        "previous_semantic_cases": {
          "const": 72
        },
        "model_calls_observed": {
          "const": 0
        },
        "r0_document_tokens": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "cl100k_base",
            "o200k_base"
          ],
          "properties": {
            "cl100k_base": {
              "const": 17204
            },
            "o200k_base": {
              "const": 17118
            }
          }
        },
        "r2_document_tokens": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "cl100k_base",
            "o200k_base"
          ],
          "properties": {
            "cl100k_base": {
              "const": 15703
            },
            "o200k_base": {
              "const": 15755
            }
          }
        },
        "r2_document_savings": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "cl100k_base",
            "o200k_base"
          ],
          "properties": {
            "cl100k_base": {
              "const": 0.0872
            },
            "o200k_base": {
              "const": 0.0796
            }
          }
        },
        "every_measured_document_and_request_cheaper": {
          "const": true
        },
        "model_fidelity_claim": {
          "const": false
        }
      }
    },
    "included_scope": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "excluded_scope": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "observation_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fresh_cases",
        "prior_design_cases",
        "hosted_calls_observed",
        "efficacy_observations",
        "network_authorized"
      ],
      "properties": {
        "fresh_cases": {
          "const": 48
        },
        "prior_design_cases": {
          "const": 72
        },
        "hosted_calls_observed": {
          "const": 0
        },
        "efficacy_observations": {
          "const": 0
        },
        "network_authorized": {
          "const": false
        }
      }
    }
  }
}
