{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://a-lang.invalid/schema/provider-profiles-v1.schema.json",
  "title": "A-Lang fidelity provider profiles v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "profiles"],
  "properties": {
    "format": { "const": "alang-fidelity-provider-profiles-v1" },
    "profiles": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": { "$ref": "#/$defs/profile" }
    }
  },
  "$defs": {
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family",
        "provider",
        "api",
        "model_id",
        "effort",
        "turns",
        "tools_enabled",
        "provider_schema_constraint",
        "max_output_tokens",
        "accepted_output_bytes",
        "exact_identifier_required"
      ],
      "properties": {
        "family": { "enum": ["ornith", "mixtral"] },
        "provider": { "enum": ["Ollama"] },
        "api": { "enum": ["ChatCompletions"] },
        "model_id": { "enum": ["ornith-1.0", "mixtral-8x7b"] },
        "effort": { "const": "medium" },
        "turns": { "const": 1 },
        "tools_enabled": { "const": false },
        "provider_schema_constraint": { "const": false },
        "max_output_tokens": { "const": 8192 },
        "accepted_output_bytes": { "const": 8192 },
        "exact_identifier_required": { "const": true }
      }
    }
  }
}
