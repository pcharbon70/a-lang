{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://a-lang.invalid/schema/campaign-policy-v1.schema.json",
  "title": "A-Lang fidelity campaign policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "network_default",
    "live_opt_in",
    "design",
    "ceilings",
    "replacement",
    "uncertain_outcomes",
    "retention"
  ],
  "properties": {
    "format": { "const": "alang-fidelity-campaign-policy-v1" },
    "network_default": { "const": "disabled" },
    "live_opt_in": {
      "type": "object",
      "additionalProperties": false,
      "required": ["environment_variable", "required_value", "credentials_required"],
      "properties": {
        "environment_variable": { "const": "ALANG_FIDELITY_LIVE" },
        "required_value": { "const": "I_UNDERSTAND_HOSTED_CALLS" },
        "credentials_required": {
          "const": ["OPENAI_API_KEY", "ANTHROPIC_API_KEY"]
        }
      }
    },
    "design": {
      "type": "object",
      "additionalProperties": false,
      "required": ["semantic_cases", "conditions", "model_families", "paired_repetitions"],
      "properties": {
        "semantic_cases": { "const": 24 },
        "conditions": { "const": 2 },
        "model_families": { "const": 2 },
        "paired_repetitions": { "const": 3 }
      }
    },
    "ceilings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary_calls", "all_calls", "cost_usd", "accepted_source_bytes", "accepted_response_bytes"],
      "properties": {
        "primary_calls": { "const": 288 },
        "all_calls": { "const": 576 },
        "cost_usd": { "const": 200 },
        "accepted_source_bytes": { "const": 8192 },
        "accepted_response_bytes": { "const": 8192 }
      }
    },
    "replacement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["blind_retry", "max_replacements_per_primary_cell", "allowed_only_when", "forbidden_when"],
      "properties": {
        "blind_retry": { "const": false },
        "max_replacements_per_primary_cell": { "const": 1 },
        "allowed_only_when": { "type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true },
        "forbidden_when": { "type": "array", "minItems": 5, "maxItems": 5, "uniqueItems": true }
      }
    },
    "uncertain_outcomes": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true
    },
    "retention": {
      "type": "object",
      "additionalProperties": false,
      "required": ["retain", "exclude"],
      "properties": {
        "retain": { "type": "array", "minItems": 5, "maxItems": 5, "uniqueItems": true },
        "exclude": { "type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true }
      }
    }
  }
}
