{
  "format": "alang-fidelity-decision-v1",
  "primary_metric": {
    "name": "exact-normalized-semantic-fidelity",
    "weighting": "all-fields-exact",
    "judge": "deterministic-beam-validator"
  },
  "secondary_metrics": [
    "component-exactness",
    "omission-count",
    "invention-count",
    "authority-widening-rate",
    "false-completion-rate",
    "repair-yield",
    "latency-ms",
    "token-count",
    "cost-usd"
  ],
  "invalid_first_responses": [
    "definitive-refusal",
    "truncated",
    "malformed-json",
    "schema-invalid"
  ],
  "bootstrap": {
    "sampling_unit": "semantic-case",
    "strata": "task-family-eight-cases",
    "paired": true,
    "repetitions_retained": 3,
    "resamples": 10000,
    "seed": 20260805,
    "confidence_percent": 95,
    "interval": "percentile"
  },
  "promotion": {
    "minimum_absolute_percentage_points": 5,
    "paired_ci_lower_strictly_above": 0,
    "each_model_family": true
  },
  "replacement": {
    "control_exact_fidelity_percent_at_least": 80,
    "each_model_family": true
  },
  "safety_vetoes": [
    "authority-widening",
    "false-completion",
    "secret-disclosure",
    "cross-case-leakage"
  ],
  "outcomes": [
    "promote-alang-source-v2",
    "replace-with-json-control",
    "stop-surface-expansion",
    "stop-invalid-campaign-no-efficacy-conclusion"
  ]
}
