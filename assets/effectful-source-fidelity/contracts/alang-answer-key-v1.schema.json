{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://a-lang.invalid/schema/alang-answer-key-v1.schema.json",
  "title": "A-Lang representation-neutral answer key v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "case_id", "semantic_digest", "expected"],
  "properties": {
    "format": { "const": "alang-answer-key-v1" },
    "case_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "semantic_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "expected": {
      "$ref": "alang-task-comprehension-v1.schema.json"
    }
  }
}
