// corpus-case: ad-missing-information
// semantic-sha256: d5428dbc1fecbe7bcd386408826f88d37b10547cc0cda4bcb2e8ee90e4bb8480
// model-visible-begin
task ad-missing-information {
  facts ["Do not create a child or delegate authority until the child brief is supplied"];
  input child-brief: text required;
  effects [];
  requirements [];
  scopes { models []; workspaces []; paths []; }
  limits { steps 1; model-calls 0; repair-calls 0; child-calls 0; workspace-writes 0; output-bytes 256; timeout-ms 5000; }
  step finish: complete depends [];
  on-error [];
  child none;
  complete [clarification-recorded "child-brief": true];
  clarify ["Child brief is required before delegation"];
  terminal needs-clarification;
}
