#!alang-source-v2
// corpus-case: ad-semantic-perturbation
// semantic-sha256: 169054ea56651de8a70995e8a27addfa4fe2a7fca55f927782b5583455c742bf
// model-visible-begin
task ad-semantic-perturbation {
  scopes { paths ["/workspace/delegated-review.md"]; workspaces [review-workspace]; models [child-reviewer]; }
  requirements [workspace review-workspace, model child-reviewer];
  facts ["Retain workspace authority in the parent", "Delegate one review summary"];
  input review-facts: json required;
  effects [workspace.write, model.generate, child.run];
  limits { timeout-ms 35000; output-bytes 2048; workspace-writes 1; child-calls 1; repair-calls 0; model-calls 1; steps 3; }
  step delegate: child.run depends [];
  step save: workspace.write depends [delegate];
  step finish: complete depends [save];
  child { requirements [model child-reviewer]; effects [model.generate]; scopes { paths []; workspaces []; models [child-reviewer]; } limits { timeout-ms 25000; output-bytes 2048; workspace-writes 0; child-calls 0; repair-calls 0; model-calls 1; steps 2; } }
  on-error [];
  complete [max-bytes "/workspace/delegated-review.md": 2048, artifact-exists "/workspace/delegated-review.md": true];
  clarify [];
  terminal complete;
}
