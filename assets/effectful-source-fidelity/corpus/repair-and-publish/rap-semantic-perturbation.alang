#!alang-source-v2
// corpus-case: rap-semantic-perturbation
// semantic-sha256: a0fc60ed2cbce96737ed83112728dd5bf21e445b82c0c94f105e1461a52efcdc
// model-visible-begin
task rap-semantic-perturbation {
  scopes { paths ["/workspace/audit-note.md"]; workspaces [audit-workspace]; models [repair-model]; }
  requirements [workspace audit-workspace, model repair-model];
  facts ["Publish only the repaired form", "Draft an audit note from the supplied findings"];
  input audit-findings: json required;
  effects [workspace.write, model.generate];
  limits { timeout-ms 35000; output-bytes 2048; workspace-writes 1; child-calls 0; repair-calls 1; model-calls 2; steps 4; }
  step draft: model.generate depends [];
  step repair: model.repair depends [draft];
  step save: workspace.write depends [repair];
  step finish: complete depends [save];
  child none;
  on-error [];
  complete [max-bytes "/workspace/audit-note.md": 2048, artifact-exists "/workspace/audit-note.md": true];
  clarify [];
  terminal complete;
}
