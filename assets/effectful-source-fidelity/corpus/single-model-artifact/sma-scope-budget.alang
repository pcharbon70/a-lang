#!alang-source-v2
// corpus-case: sma-scope-budget
// semantic-sha256: 1cf7c6e2c0f4ffa61928845071b1232979cbbe38932a2edc7db2f5c5293d3b40
// model-visible-begin
task sma-scope-budget {
  facts ["Summarize the supplied incident into the single allowed artifact", "Use no model or workspace outside the declared scope"];
  input incident-record: json required;
  effects [workspace.write, model.generate];
  requirements [workspace isolated-workspace, model summarizer-model];
  scopes { models [summarizer-model]; workspaces [isolated-workspace]; paths ["/workspace/incident-summary.md"]; }
  limits { steps 3; model-calls 1; repair-calls 0; child-calls 0; workspace-writes 1; output-bytes 1024; timeout-ms 15000; }
  step summarize: model.generate depends [];
  step store: workspace.write depends [summarize];
  step finish: complete depends [store];
  on-error [];
  child none;
  complete [artifact-exists "/workspace/incident-summary.md": true, max-bytes "/workspace/incident-summary.md": 1024];
  clarify [];
  terminal complete;
}
