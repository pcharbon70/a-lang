{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://a-lang.invalid/schema/compact-tokenizer-profiles-v1.schema.json",
  "title": "A-Lang compact tokenizer profiles v1",
  "type": "object", "additionalProperties": false,
  "required": ["format", "provider_accounting", "screening_tokenizers"],
  "properties": {
    "format": {"const": "alang-compact-tokenizer-profiles-v1"},
    "provider_accounting": {
      "type": "object", "additionalProperties": false,
      "required": ["role", "missing_usage", "estimated_usage"],
      "properties": {"role": {"const": "authoritative-for-provider-and-full-request-metrics"}, "missing_usage": {"const": "invalid-trial"}, "estimated_usage": {"const": "forbidden"}}
    },
    "screening_tokenizers": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/tokenizer"}}
  },
  "$defs": {
    "tokenizer": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "implementation", "version", "encoding", "role", "exact_version_required"],
      "properties": {
        "id": {"enum": ["tiktoken-0.12.0-cl100k-base", "tiktoken-0.12.0-o200k-base"]},
        "implementation": {"const": "tiktoken"},
        "version": {"const": "0.12.0"},
        "encoding": {"enum": ["cl100k_base", "o200k_base"]},
        "role": {"const": "document-screening-only"},
        "exact_version_required": {"const": true}
      }
    }
  }
}
