{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://a-lang.invalid/schema/compact-traceability-v1.schema.json","title":"A-Lang compact traceability v1","type":"object","additionalProperties":false,
  "required":["format","sources","condition_hypotheses","primary_metric_ids","secondary_metric_ids","metric_rationales","included_scope","excluded_scope","prior_campaign_boundary"],
  "properties":{
    "format":{"const":"alang-compact-traceability-v1"},"sources":{"type":"array","minItems":5,"items":{"$ref":"#/$defs/source"}},"condition_hypotheses":{"type":"array","minItems":6,"maxItems":6,"items":{"$ref":"#/$defs/hypothesis"}},
    "primary_metric_ids":{"type":"array","minItems":4,"uniqueItems":true,"items":{"type":"string"}},"secondary_metric_ids":{"type":"array","minItems":10,"uniqueItems":true,"items":{"type":"string"}},"metric_rationales":{"type":"array","minItems":4,"items":{"$ref":"#/$defs/rationale"}},
    "included_scope":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string"}},"excluded_scope":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string"}},"prior_campaign_boundary":{"$ref":"#/$defs/boundary"}
  },
  "$defs":{
    "source":{"type":"object","additionalProperties":false,"required":["role","path"],"properties":{"role":{"type":"string","minLength":1},"path":{"type":"string","minLength":1}}},
    "hypothesis":{"type":"object","additionalProperties":false,"required":["id","hypothesis"],"properties":{"id":{"enum":["R0","R1","R2","R3","R4","R5"]},"hypothesis":{"type":"string","minLength":1}}},
    "rationale":{"type":"object","additionalProperties":false,"required":["group","source_role","reason"],"properties":{"group":{"type":"string","minLength":1},"source_role":{"type":"string","minLength":1},"reason":{"type":"string","minLength":1}}},
    "boundary":{"type":"object","additionalProperties":false,"required":["base","registration_file_count","registration_digest","archive_file_count","archive_digest","digest_algorithm","mutation"],"properties":{"base":{"const":"assets/effectful-source-fidelity"},"registration_file_count":{"const":86},"registration_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},"archive_file_count":{"const":182},"archive_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},"digest_algorithm":{"const":"sha-256-canonical-etf-v1"},"mutation":{"const":"forbidden"}}}
  }
}
