    {"group":"budget-key","aliases":[{"readable":"steps","compact":"s"},{"readable":"model-calls","compact":"m"},{"readable":"repair-calls","compact":"r"},{"readable":"child-calls","compact":"c"},{"readable":"workspace-writes","compact":"w"},{"readable":"output-bytes","compact":"b"},{"readable":"timeout-ms","compact":"t"}]},
