#{
  fixture_format => alang_semantic_fixture_v1,
  language => alang,
  semantic_version => <<"phase1-ir-v1">>,
  module => phase1_counter_v1,
  entrypoint => {start, 1},
  runtime_abi => alang_v1,
  types => #{
    input => {integer_range, 0, 1000000},
    state => {closed_sum, [waiting, completed]},
    result => {
      closed_sum,
      [
        {ok, successor_integer},
        {
          error,
          [
            malformed_envelope,
            unsupported_abi,
            invalid_correlation,
            invalid_reply_target,
            invalid_payload,
            payload_too_large,
            unavailable_operation,
            unexpected_process_exit
          ]
        }
      ]
    }
  },
  transition => #{
    from => waiting,
    input_binding => value,
    to => completed,
    result => {integer_add, value, 1}
  },
  runtime_operations => [
    initialize,
    receive_envelope,
    emit_trace,
    reply_result,
    terminate
  ],
  limits => #{
    correlation_bytes => {1, 64},
    envelope_bytes => 1024
  }
}.
